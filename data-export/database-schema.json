{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "appName": "Học Siêu Vui",
  "version": "1.0.0",
  "description": "Database Schema and Entity Relationship definitions for Hoc Sieu Vui platform",
  "databaseEngines": {
    "relational": "PostgreSQL 14+ / MySQL 8.0+",
    "document": "MongoDB 6.0+ / Firebase Firestore"
  },
  "tables": [
    {
      "tableName": "students",
      "description": "Bảng tài khoản học sinh, lưu trữ thông tin cơ bản, điểm tích lũy, cấp bậc và mật khẩu",
      "primaryKey": "id",
      "columns": [
        { "name": "id", "type": "VARCHAR(64)", "nullable": false, "description": "Mã định danh duy nhất của học sinh (UUID)" },
        { "name": "name", "type": "VARCHAR(100)", "nullable": false, "unique": true, "description": "Biệt danh học sinh hiển thị trong game và bảng xếp hạng" },
        { "name": "grade", "type": "VARCHAR(20)", "nullable": false, "default": "'6A1'", "description": "Lớp học (VD: 6A1, 6A2...)" },
        { "name": "school", "type": "VARCHAR(150)", "nullable": false, "default": "'THCS'", "description": "Trường THCS theo học" },
        { "name": "password_hash", "type": "VARCHAR(255)", "nullable": false, "description": "Mật khẩu mã hóa (mặc định hocvui123)" },
        { "name": "coins", "type": "INT", "nullable": false, "default": 120, "description": "Số Xu 🪙 hiện có (kiếm được từ làm bài tập)" },
        { "name": "stars", "type": "INT", "nullable": false, "default": 3, "description": "Số Sao ⭐ tích lũy (dùng để thăng cấp và đua top)" },
        { "name": "level", "type": "INT", "nullable": false, "default": 1, "description": "Cấp độ học sinh (tính theo số bài hoàn thành và Sao)" },
        { "name": "exp", "type": "INT", "nullable": false, "default": 0, "description": "Điểm kinh nghiệm" },
        { "name": "high_score_blitz", "type": "INT", "nullable": false, "default": 0, "description": "Điểm kỷ lục trong Đấu trường tính nhanh 60 giây" },
        { "name": "motto", "type": "VARCHAR(255)", "nullable": true, "default": "'Học hết mình, chơi siêu vui!'", "description": "Châm ngôn học tập hiển thị trên thẻ học sinh" },
        { "name": "is_guest", "type": "BOOLEAN", "nullable": false, "default": false, "description": "Đánh dấu tài khoản dùng thử khách" },
        { "name": "created_at", "type": "TIMESTAMP", "nullable": false, "default": "CURRENT_TIMESTAMP", "description": "Thời điểm tạo tài khoản" }
      ]
    },
    {
      "tableName": "avatar_configurations",
      "description": "Cấu hình ngoại hình Avatar của học sinh",
      "primaryKey": "student_id",
      "foreignKeys": [
        { "column": "student_id", "referencesTable": "students", "referencesColumn": "id", "onDelete": "CASCADE" }
      ],
      "columns": [
        { "name": "student_id", "type": "VARCHAR(64)", "nullable": false },
        { "name": "gender", "type": "VARCHAR(20)", "nullable": false, "default": "'boy'" },
        { "name": "skin_color", "type": "VARCHAR(30)", "nullable": false, "default": "'#fed7aa'" },
        { "name": "hair_style", "type": "VARCHAR(50)", "nullable": false, "default": "'short_neat'" },
        { "name": "hair_color", "type": "VARCHAR(30)", "nullable": false, "default": "'#1e293b'" },
        { "name": "eye_expression", "type": "VARCHAR(50)", "nullable": false, "default": "'sparkle_glasses'" },
        { "name": "equipped_outfit", "type": "VARCHAR(64)", "nullable": false, "default": "'outfit_uniform'" },
        { "name": "equipped_handheld", "type": "VARCHAR(64)", "nullable": false, "default": "'item_pen_compass'" },
        { "name": "equipped_phone", "type": "VARCHAR(64)", "nullable": false, "default": "'phone_none'" },
        { "name": "equipped_vehicle", "type": "VARCHAR(64)", "nullable": false, "default": "'vehicle_none'" },
        { "name": "equipped_tech", "type": "VARCHAR(64)", "nullable": false, "default": "'tech_none'" },
        { "name": "equipped_pet", "type": "VARCHAR(64)", "nullable": false, "default": "'pet_none'" }
      ]
    },
    {
      "tableName": "student_inventory",
      "description": "Danh sách vật phẩm phụ kiện học sinh đã mở khóa hoặc mua từ Studio",
      "primaryKey": "id",
      "foreignKeys": [
        { "column": "student_id", "referencesTable": "students", "referencesColumn": "id", "onDelete": "CASCADE" },
        { "column": "item_id", "referencesTable": "shop_items", "referencesColumn": "id" }
      ],
      "columns": [
        { "name": "id", "type": "BIGSERIAL", "nullable": false },
        { "name": "student_id", "type": "VARCHAR(64)", "nullable": false },
        { "name": "item_id", "type": "VARCHAR(64)", "nullable": false },
        { "name": "unlocked_at", "type": "TIMESTAMP", "nullable": false, "default": "CURRENT_TIMESTAMP" }
      ]
    },
    {
      "tableName": "student_lesson_progress",
      "description": "Tiến trình và kết quả vượt ải các bài học SGK",
      "primaryKey": "id",
      "columns": [
        { "name": "id", "type": "BIGSERIAL", "nullable": false },
        { "name": "student_id", "type": "VARCHAR(64)", "nullable": false },
        { "name": "lesson_id", "type": "VARCHAR(64)", "nullable": false },
        { "name": "stars_earned", "type": "INT", "nullable": false, "default": 0 },
        { "name": "best_score", "type": "INT", "nullable": false, "default": 0 },
        { "name": "completed_at", "type": "TIMESTAMP", "nullable": false, "default": "CURRENT_TIMESTAMP" }
      ]
    },
    {
      "tableName": "shop_items",
      "description": "Kho phụ kiện trong Studio (quần áo, phương tiện, điện thoại, laptop, pet)",
      "primaryKey": "id",
      "columns": [
        { "name": "id", "type": "VARCHAR(64)", "nullable": false },
        { "name": "name", "type": "VARCHAR(150)", "nullable": false },
        { "name": "category", "type": "VARCHAR(30)", "nullable": false, "description": "outfit, handheld, phone, vehicle, tech, pet" },
        { "name": "cost_coins", "type": "INT", "nullable": false, "default": 0 },
        { "name": "cost_stars", "type": "INT", "nullable": false, "default": 0 },
        { "name": "description", "type": "TEXT", "nullable": false },
        { "name": "rarity", "type": "VARCHAR(30)", "nullable": false, "default": "'base'" },
        { "name": "tagline", "type": "VARCHAR(100)", "nullable": true },
        { "name": "render_type", "type": "VARCHAR(64)", "nullable": false }
      ]
    },
    {
      "tableName": "system_announcements",
      "description": "Thông báo phát toàn trang từ quản trị viên",
      "primaryKey": "id",
      "columns": [
        { "name": "id", "type": "BIGSERIAL", "nullable": false },
        { "name": "content", "type": "TEXT", "nullable": false },
        { "name": "is_active", "type": "BOOLEAN", "nullable": false, "default": true },
        { "name": "updated_by", "type": "VARCHAR(100)", "nullable": false, "default": "'dungvt.hbh'" },
        { "name": "updated_at", "type": "TIMESTAMP", "nullable": false, "default": "CURRENT_TIMESTAMP" }
      ]
    }
  ]
}
